[Unit]
Description=CycleForge private OpenAI-compatible inference
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/opt/cycleforge-loop/secrets/cycleforge-inference.env
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
ExecStart=/opt/vllm/bin/vllm serve /models/Qwen3-4B --served-model-name cf-v2-base --host 127.0.0.1 --port 8000 --gpu-memory-utilization 0.85 --max-model-len 16384 --enforce-eager
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
