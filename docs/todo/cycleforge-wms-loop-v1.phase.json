{
  "schemaVersion": 1,
  "planId": "cycleforge-wms-loop-v1",
  "executionContract": {
    "workingDirectory": "${REPO_ROOT}",
    "preferredHarness": "omp --advisor",
    "harnessRequired": false,
    "completionRule": "A phase is verified only when every verifier exits 0 and its evidence assertions pass.",
    "secretsPolicy": "Never persist or print secret values; verify projections by provenance hash."
  },
  "repositories": {
    "domain": "${REPO_ROOT}",
    "controlPlane": "${GARISEK_OS_ROOT}"
  },
  "devices": [
    {
      "id": "avion",
      "role": "development-and-loop-host",
      "transport": "local"
    },
    {
      "id": "prometheus",
      "role": "operator-and-fallback-host",
      "transport": "ssh"
    },
    {
      "id": "gex45",
      "role": "private-inference-host",
      "transport": "ssh"
    }
  ],
  "phases": [
    {
      "id": "CF-WMS-DOCS-1",
      "status": "verified",
      "verifiers": [
        {
          "command": "pnpm verify:ecwid-documents-v1",
          "asserts": [
            "ecwid-invoice-pdf",
            "post-ingest-packing-slip",
            "mobile-direct-packing-slip-preview",
            "mobile-imported-label-preview",
            "mobile-missing-label-upload",
            "desktop-packing-slip-preview"
          ]
        },
        {
          "command": "pnpm verify:fast",
          "asserts": ["repository-fast-gates"]
        }
      ]
    },
    {
      "id": "CF-WMS-COMPUTE-1",
      "status": "verified",
      "verifiers": [
        {
          "command": "pnpm verify:cycleforge-inference",
          "asserts": [
            "env-provenance",
            "systemd-active",
            "systemd-enabled",
            "loopback-health",
            "model-identity",
            "structured-slot-full-reroute"
          ]
        }
      ]
    },
    {
      "id": "CF-WMS-GRAPH-1",
      "status": "verified",
      "verifiers": [
        {
          "command": "pnpm verify:wms-graph",
          "asserts": [
            "strict-slot-full-envelope",
            "capacity-valid-reroute-intent",
            "safe-no-capacity-rejection",
            "no-model-authored-database-authority",
            "tenant-scoped-cycleforge-commit-adapter",
            "live-neon-transaction-rollback",
            "idempotent-stable-mutation-replay"
          ]
        }
      ]
    },
    {
      "id": "CF-WMS-STREAM-1",
      "status": "verified",
      "verifiers": [
        {
          "command": "pnpm verify:wms-stream",
          "asserts": [
            "switchboard-uws-health",
            "whisper-and-qwen-vl-ingestion",
            "thirty-run-under-150ms-sla",
            "reconnect-idempotency-replay",
            "persistent-mobile-shell-dom-ack",
            "short-lived-ticket-refresh",
            "pick-confirm-short-socket-command",
            "putaway-adjust-socket-command",
            "putaway-capacity-and-overdraw-guard",
            "pack-verification-socket-command",
            "pick-pack-putaway-zero-legacy-routing-ast",
            "twenty-four-execution-actions-motion-ast",
            "operator-owned-capacity-configuration",
            "pick-putaway-pack-motion-press-depth"
          ]
        }
      ]
    }
  ]
}
