--- /dev/null
+++ b/src/lib/right-rail/useCenterSplitColumns.ts
@@ -0,0 +1,41 @@
+'use client';
+
+/**
+ * Publish a route's center-split demand into the right-rail frame budget.
+ *
+ * **Reserving for a split and dividing a host between panes are two jobs, and
+ * this hook is only the first.** The frame is the only place that can see all
+ * three columns, so it is what must reserve `columns × paneMin` before handing
+ * the right panel a cap — otherwise opening the inspector silently eats pane
+ * width (measured 2026-08-19 at 1440: `480 + 260` against a 360 min,
+ * `tests/e2e/frame-baseline.spec.ts`).
+ *
+ * Dividing the host is the *host's* job and uses the host's own measured width,
+ * because the frame cannot see the sheet chrome between them — at 1440 the frame
+ * knows the center is 1020 while the compare host is 741. That local measurement
+ * is not the circular input `frame.ts` refuses: splitting a known width between
+ * panes feeds nothing back into whether the panel pushes.
+ *
+ * Declaring `{ columns: 1, paneMinPx: 0 }` (or unmounting) restores the frame
+ * exactly as it was — a route with no split open sees no change.
+ */
+
+import { useEffect } from 'react';
+import { setCenterSplitDemand } from './frame';
+
+export function useCenterSplitDemand(demand: {
+  /** Side-by-side COLUMNS this host wants (quad is 2, not 4). */
+  columns: number;
+  /** The narrowest one column may be worked at. */
+  paneMinPx: number;
+  gapPx?: number;
+}): void {
+  const { columns, paneMinPx, gapPx = 0 } = demand;
+
+  useEffect(() => {
+    setCenterSplitDemand({ columns, paneMinPx, gapPx });
+    // Hand the budget back on unmount, or a route that navigated away keeps
+    // reserving pane width the next surface has no panes for.
+    return () => setCenterSplitDemand({ columns: 1, paneMinPx: 0, gapPx: 0 });
+  }, [columns, paneMinPx, gapPx]);
+}
