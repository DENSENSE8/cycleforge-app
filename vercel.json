    {
      "path": "/api/cron/sessions-sweep",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/photos/analyze?limit=15",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/photos/nas-mirror?limit=25",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/documents/nas-mirror?limit=25",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/documents/ensure-outbound?limit=25",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/documents/ecwid-packing-slips?limit=25",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/photos/drive-mirror?limit=25",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/signals/buyer-notes-heal",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/tickets/designated-assign",
      "schedule": "*/15 * * * *"
    }
  ]
}
