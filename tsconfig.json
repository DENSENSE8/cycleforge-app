{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-perf-si/types/**/*.ts",
    ".next-crashfix/types/**/*.ts",
    ".next-perf-lh/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-lh/types/**/*.ts",
    ".next-lh/dev/types/**/*.ts",
    ".next-perf-lh/dev/types/**/*.ts",
    ".next-vercel/types/**/*.ts",
    ".next-vercel/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile",
    "packages/shared",
    "apps/web",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
