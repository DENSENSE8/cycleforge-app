.jscpd/

# Previous Electron build artifact tree (should never be committed)
apps/desktop/

# PWA / service worker — generated by `pnpm build:webpack` (next-pwa).
# Vercel skips that compile (OOM); we commit the last-known artifacts so
# offline still works. Re-run build:webpack locally when caching rules change
# and commit the updated public/sw.js + workbox-* / fallback-* / swe-worker-*.
/logs/

# Manuals: source docx and converted PDF artifacts live in Vercel Blob now;
# these directories are intermediate output from scripts/convert-and-upload-manuals.mjs
/public/Manuals/
/converted-manuals/

docker-compose.db.yml

# Playwright E2E artifacts + saved auth storage state
/playwright-report/
/test-results/
/tests/.auth/
# Playwright MCP server scratch output (console logs + page snapshots)
.playwright-mcp/
.playwright/

# Local-only scratch script artifacts (studio verify runs, screenshots, one-off helpers)
scripts/_screenshots/
scripts/_verify-*
scripts/_mint-*
scripts/_fix-*
.env*
!.env.example

# Build installers (large artifacts; do not commit)
context/*.exe
*.exe
# electron-builder output dirs (installer + win-unpacked + builder metadata)
desktop-dist/
desktop-dist2/

# reversible snapshot for mark-board-shipped-test.ts (contains live tracking state)
scripts/.shipped-test-snapshot.json

# crush agent local state
.crush/

# Lighthouse audit output (scripts/lighthouse-audit.mjs) — keep summary.md snapshots in docs, not raw LHR blobs
/lighthouse/
/.next-perf/
/.next-perf-si/
/.next-perf-lh/

# Side-by-side dev servers run with NEXT_DIST_DIR so they cannot clobber the
# `.next` the :3050 server is using (docs/integrations/realtime-ai.md).
/.next-*/

# Desktop shell app-manifest deps (installed by `pnpm desktop:deps`).
# electron/package-lock.json is TRACKED on purpose: `npm ci --prefix electron`
# needs it, and it is what pins electron-updater (the auto-update signature
# verifier) instead of floating it on every desktop build.
electron/node_modules/

# npm's lockfile at the root is never a source of truth — pnpm-lock.yaml is
# (vercel.json and the workflow both run `pnpm install --frozen-lockfile`).
/package-lock.json

# Generated test output — never track (98k+ lines of TAP per run)
.cycle_forge_ops/logs/*.tap

# Local vision dataset — 13GB of captures/derivatives, regenerated locally, never tracked
vision/data/

# Machine-local CLI state — an absolute symlink into the developer's home.
.antigravitycli/

# ── Warehouse OS refactor (2026-08-21) ───────────────────────────────────────
# The house-law corpus (rules, SoT manifest, design-law guards, Cursor tree)
# was deleted on purpose. These paths must not silently return.
#
# `.cursor/mcp.json` is the one carve-out (2026-08-30): it is MCP *wiring*, not
# house law, and Cursor reads only from `.cursor/`. Tracking it is what lets
# `.mcp.json` be a symlink to it — one file, both clients. Operator 2026-08-31:
# also track hooks + rules that enforce design-mcp (plugin load, session stamp,
# UI write gate). Session receipts stay banned under the blanket `.cursor/*`.
.garisek/
.cursor/*
!.cursor/mcp.json
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
.claude/rules/
.claude/agents/
.claude/hooks/
docs/rules/
sot-manifest.json
# local-only agent worktrees — never belong in the repo
.claude/worktrees/
.worktrees/

# Playwright signed-in storage state for visual baselines — a REAL session.
tests/visual/.auth.json
tests/visual/**/*-snapshots/

# eval runners overwrite one machine-readable summary per cohort (D7 item 16) — never tracked
docs/eval/**/latest.json

# Self-hosted CI state (queue, receipts, cache, logs) — box-local, written by scripts/ci-runner.mjs
/.ci/

# accidental nested clone / inner cursor stamp
cycleforge-app/

# ZCode MCP config can hold a Figma PAT - never commit
.zcode/
