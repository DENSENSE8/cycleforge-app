# Build and dependency artifacts
.next
.next-perf
node_modules
desktop-dist
build
out
coverage
lighthouse
tmp
# Local vision dataset — 13GB of captures/derivatives, regenerated locally and
# never tracked (`.gitignore` has it too). It must be named HERE as well: Vercel
# consults `.gitignore` only when no `.vercelignore` exists, so with this file
# present the CLI was packing all 13GB into every deployment and the upload
# aborted before a build could start.
vision/data

# Local/runtime metadata
.git
.vercel
.DS_Store
*.log
*.tsbuildinfo
.cursor
.claude
.agents
# Machine-local CLI state. `.antigravitycli/` holds an ABSOLUTE symlink into a
# developer's home (`~/.gemini/config/...`), which is dangling everywhere else —
# Vercel rejects the upload outright ("is not a valid symlink"), so this took
# down production deploys, CI's included.
.antigravitycli
.gemini
.obsidian
.impeccable
.cycle_forge_ops

# Env and local-only files
.env
.env.local
.env.*.local

# Electron/desktop extras not needed for web deploy
/electron
server/storage
