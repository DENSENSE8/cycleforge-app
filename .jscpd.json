{
  "minLines": 20,
  "minTokens": 100,
  "maxLines": 1000,
  "maxSize": "200kb",
  "gitignore": true,
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/desktop-dist/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.guard.test.ts",
    "src/components/station/*-grid/cells/**",
    "**/incoming-grid/cells/**",
    "**/receiving-grid/cells/**",
    "**/ready/grid/cells/**",
    "**/*-grid/cells/**",
    "src/components/dashboard/orders-queue/*-layout.ts",
    "src/components/tables/admin-data-tables/**",
    "**/*-grid-layout.ts",
    "**/dashboard-order-row-layout.ts",
    "**/*GridColumnHeader.tsx",
    "**/makeLedgerGridColumnHeader.tsx",
    "**/DataTable/**",
    "src/app/admin/**",
    "src/components/admin/**",
    "**/StationDisplaysPushStack.tsx",
    "**/StationDisplaysPushColumn.tsx",
    "**/RightRailHost.tsx"
  ],
  "reporters": ["json"],
  "output": "reports/jscpd",
  "absolute": false,
  "silent": true
}
