+import { requirePermission } from '@/lib/auth/page-guard';
+import { MobileToteList } from '@/components/mobile/handling-units/MobileToteList';
+
+export const dynamic = 'force-dynamic';
+
+/** `/m/h` — every tote of the org (route-tree node `containers`; door: the phone menu › Inventory › Containers). A card opens the tote record. */
+export default async function MobileTotesPage() {
+  await requirePermission('handling_unit.view');
+  return <MobileToteList />;
+}
