@@ -0,0 +1,71 @@
+'use client';
+
+/**
+ * `/m/h` — every tote of the org, newest first (route-tree node `containers`).
+ * One `MobileRecordCard` per tote: its code, where it sits, how many units it
+ * holds and its status. A card opens the tote record (`containerPath`).
+ */
+
+import { useRouter } from 'next/navigation';
+import { useQuery } from '@tanstack/react-query';
+import { MobileRecordCard, MobileRecordCardList } from '@/design-system/components/MobileRecordCard';
+import { withJobReturn } from '@/lib/mobile/nav-trail';
+import { containerPath, WAREHOUSE_PATHS } from '@/lib/nav/route-tree';
+import { sentenceCaseLabel } from '@/lib/text/sentence-case-label';
+import { formatMonthDayTimePST } from '@/utils/date';
+
+interface ToteListItem {
+  id: number;
+  code: string;
+  status: string;
+  location_name: string | null;
+  unit_count: number;
+  created_at: string;
+}
+
+async function listTotes(): Promise<ToteListItem[]> {
+  const res = await fetch('/api/handling-units?limit=500', { cache: 'no-store' });
+  const json = (await res.json().catch(() => null)) as { success?: boolean; handling_units?: ToteListItem[]; error?: string } | null;
+  if (!res.ok || !json?.success) throw new Error(json?.error || `Could not load totes (${res.status})`);
+  return json.handling_units ?? [];
+}
+
+const unitsLine = (n: number) => `${n} unit${n === 1 ? '' : 's'}`;
+
+export function MobileToteList() {
+  const router = useRouter();
+  const query = useQuery({ queryKey: ['handling-units', 'tote-list'], queryFn: listTotes });
+  const totes = query.data ?? [];
+
+  return (
+    <div className="flex min-h-full flex-col bg-mode-panel" data-testid="m-totes">
+      <div className="flex-1">
+        {query.isPending ? (
+          <p className="break-words px-mode-page py-10 text-center text-role-caption text-text-muted">Loading totes…</p>
+        ) : query.isError ? (
+          <p role="alert" className="break-words px-mode-page py-10 text-center text-role-caption font-semibold text-text-danger">
+            {query.error instanceof Error ? query.error.message : 'Could not load totes.'}
+          </p>
+        ) : totes.length === 0 ? (
+          <p className="break-words px-mode-page py-10 text-center text-role-caption text-text-muted">No totes yet.</p>
+        ) : (
+          <MobileRecordCardList label={`${totes.length} tote${totes.length === 1 ? '' : 's'}`}>
+            {totes.map((tote) => (
+              <MobileRecordCard
+                key={tote.id}
+                identity={tote.code}
+                timestamp={formatMonthDayTimePST(tote.created_at)}
+                title={tote.location_name ?? 'Not at a location'}
+                detail={unitsLine(tote.unit_count)}
+                status={sentenceCaseLabel(tote.status)}
+                tone={tote.status === 'CLOSED' ? 'neutral' : 'ok'}
+                onOpen={() => router.push(withJobReturn(containerPath(tote.id), WAREHOUSE_PATHS.containers))}
+                testId="tote-card"
+              />
+            ))}
+          </MobileRecordCardList>
+        )}
+      </div>
+    </div>
+  );
+}
