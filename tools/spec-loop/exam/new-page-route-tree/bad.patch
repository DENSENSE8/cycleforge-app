+'use client';
+
+/** `/m/totes` — every tote (LPN) of the org; tap one to open it. */
+
+import { useRouter } from 'next/navigation';
+import { useQuery } from '@tanstack/react-query';
+import { MobileRecordCard, MobileRecordCardList } from '@/design-system/components/MobileRecordCard';
+
+interface Tote {
+  id: number;
+  code: string;
+  status: string;
+  location_name: string | null;
+  unit_count: number;
+}
+
+export function MobileTotesList() {
+  const router = useRouter();
+  const query = useQuery({
+    queryKey: ['totes'],
+    queryFn: async (): Promise<Tote[]> => {
+      const res = await fetch('/api/handling-units?limit=500');
+      const json = await res.json();
+      return json.handling_units ?? [];
+    },
+  });
+  const totes = query.data ?? [];
+
+  return (
+    <div className="flex min-h-full flex-col bg-mode-panel" data-testid="m-totes">
+      {query.isPending ? (
+        <p className="px-mode-page py-10 text-center text-role-caption text-text-muted">Loading totes…</p>
+      ) : (
+        <MobileRecordCardList label={`${totes.length} totes`}>
+          {totes.map((tote) => (
+            <MobileRecordCard
+              key={tote.id}
+              identity={tote.code}
+              title={tote.location_name ?? 'No location'}
+              detail={`${tote.unit_count} units`}
+              status={tote.status}
+              onOpen={() => router.push(`/m/h/${tote.id}?back=/m/totes`)}
+              testId="tote-card"
+            />
+          ))}
+        </MobileRecordCardList>
+      )}
+    </div>
+  );
+}
