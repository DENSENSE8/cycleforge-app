diff --git a/src/lib/repair/repair-waiting.ts b/src/lib/repair/repair-waiting.ts
new file mode 100644
index 000000000..e08270e6b
--- /dev/null
+++ b/src/lib/repair/repair-waiting.ts
@@ -0,0 +1,26 @@
+/**
+ * The repair cards' sidebar "Waiting on" choice (`?waiting=`): narrows the
+ * loaded tickets to the ones stalled on parts (`Awaiting Parts`) or on the
+ * customer's parts money (`Awaiting Additional Parts Payment`). Declared in
+ * `REPAIR_CONTROLS` (`NAV_PAGE_DECLS`); `RepairCardList` only reads it.
+ */
+
+/** `?waiting=parts` — `/repair` and Sales › Repair service. */
+export const REPAIR_WAITING_PARAM = 'waiting';
+
+export const REPAIR_WAITING_OPTIONS = [
+  { value: 'parts', label: 'Parts', statuses: ['Awaiting Parts'] },
+  { value: 'parts-payment', label: 'Parts payment', statuses: ['Awaiting Additional Parts Payment'] },
+] as const;
+
+export type RepairWaiting = (typeof REPAIR_WAITING_OPTIONS)[number]['value'];
+
+export function parseRepairWaiting(raw: string | null | undefined): RepairWaiting | null {
+  return REPAIR_WAITING_OPTIONS.find((option) => option.value === raw)?.value ?? null;
+}
+
+/** True when a stored repair status is what `waiting` names. */
+export function isRepairWaitingOn(status: string | null | undefined, waiting: RepairWaiting): boolean {
+  const option = REPAIR_WAITING_OPTIONS.find((candidate) => candidate.value === waiting);
+  return Boolean(option && (option.statuses as readonly string[]).includes((status ?? '').trim()));
+}
