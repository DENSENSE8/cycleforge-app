+/** Assign a technician to the checked repairs. */
+function BulkAssignTechSelect({
+  repairs,
+  onDone,
+  done,
+}: {
+  repairs: readonly RSRecord[];
+  onDone: () => void;
+  done: () => void;
+}) {
+  const [staff, setStaff] = useState<StaffMember[]>([]);
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    void getActiveStaff().then(setStaff);
+  }, []);
+
+  const assign = async (value: string) => {
+    const techId = value ? Number(value) : null;
+    setSaving(true);
+    try {
+      for (const repair of repairs) {
+        await saveWorkOrder({ entityType: 'REPAIR', entityId: repair.id, assignedTechId: techId, status: techId ? 'ASSIGNED' : 'OPEN', priority: 100, deadlineAt: null });
+      }
+      toast.success('Technician assigned');
+      onDone();
+    } catch (err) {
+      toast.error(err instanceof Error ? err.message : 'Failed to assign');
+    } finally {
+      setSaving(false);
+      done();
+    }
+  };
+
+  return (
+    <select
+      className="h-8 rounded border border-border-soft bg-surface-card px-2 text-sm"
+      defaultValue=""
+      disabled={saving}
+      onChange={(e) => void assign(e.target.value)}
+      aria-label="Assign technician"
+    >
+      <option value="">Select technician…</option>
+      {staff.map((member) => (
+        <option key={member.id} value={member.id}>
+          {member.name}
+        </option>
+      ))}
+    </select>
+  );
+}
