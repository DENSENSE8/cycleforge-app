+/**
+ * The strip's Assign tech morph: the house staff assign combo (technician
+ * lane) anchored under the strip. A pick assigns every checked repair; Esc /
+ * a press outside morphs the strip back.
+ */
+function BulkAssignTechDisplay({
+  repairs,
+  onPick,
+  done,
+}: {
+  repairs: readonly RSRecord[];
+  onPick: (staffId: number | null, staffName: string | null) => void;
+  done: () => void;
+}) {
+  const anchorRef = useRef<HTMLSpanElement>(null);
+  const count = `${repairs.length} repair${repairs.length === 1 ? '' : 's'}`;
+  return (
+    <>
+      <span ref={anchorRef} className="truncate text-role-caption text-text-soft">
+        Assign a tech to {count}
+      </span>
+      <StageStaffAssignPopover
+        open
+        onClose={done}
+        anchorRef={anchorRef}
+        label={`Assign a tech to ${count}`}
+        role="technician"
+        selectedStaffId={null}
+        onCommit={(staffId, staffName) => {
+          done();
+          onPick(staffId, staffName);
+        }}
+      />
+    </>
+  );
+}
+
+/** One repair's tech through the one work-assignment writer (`work_assignments`, REPAIR work). */
+async function assignRepairTech(repair: RSRecord, staffId: number | null): Promise<void> {
+  await saveWorkOrder({
+    entityType: 'REPAIR',
+    entityId: repair.id,
+    assignedTechId: staffId,
+    status: staffId ? 'ASSIGNED' : 'OPEN',
+    priority: 100,
+    deadlineAt: null,
+  });
+}
