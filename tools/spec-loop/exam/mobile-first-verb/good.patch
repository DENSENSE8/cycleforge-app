+
+/**
+ * Mark damaged — the unit goes ON HOLD (`POST /api/serial-units/[id]/hold`,
+ * the shared `holdUnit` transaction) with what is wrong as the reason, so it
+ * leaves sellable stock without touching any other unit of its SKU.
+ */
+export function UnitDamageSheet({ open, unitId, onClose, onDone }: Omit<UnitVerbSheetProps, 'initialValue'>) {
+  const [damage, setDamage] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    setDamage('');
+    setError(null);
+  }, [open]);
+
+  const submit = async () => {
+    const what = damage.trim();
+    if (!what || busy) return;
+    setBusy(true);
+    setError(null);
+    try {
+      const { res, json } = await postUnitVerb(`/api/serial-units/${unitId}/hold`, {
+        reason: `Damaged — ${what}`,
+        client_event_id: `mu-damage-${unitId}-${Date.now()}`,
+      });
+      if (!res.ok || !json?.ok) throw new Error(json?.error || `HTTP ${res.status}`);
+      onDone('Marked damaged — the unit is on hold');
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Mark damaged failed');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <UnitRefSheet
+      open={open}
+      title="Mark damaged"
+      label="What is damaged?"
+      value={damage}
+      onChange={setDamage}
+      busy={busy}
+      error={error}
+      notice={null}
+      submitLabel="Mark damaged"
+      onSubmit={() => void submit()}
+      onClose={onClose}
+    />
+  );
+}
